{
  "name": "@sailingrotevista/rotevista-dash",
  "version": "9.6.0-beta.8",
  "description": "Wind Dashboard with navigation and course aids",
  "main": "index.js",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "signalk-webapp",
    "signalk-node-server-plugin",
    "signalk-category-instruments"
  ],
  "author": "Sailing Rotevista",
  "license": "MIT",
  "signalk": {
    "displayName": "Rotevista Wind Dashboard",
    "appIcon": "icons/dash.png"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && mkdir -p dist && cp -r public/. dist/",
    "prepublishOnly": "npm run build",
    "lint": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port 3000"
  },
  "files": [
    "index.js",
    "ais",
    "wind",
    "session",
    "simulation",
    "shared",
    "sensors",
    "public",
    "icons",
    "apple-touch-icon.png",
    "manifest.json",
    "settings.json"
  ],
  "dependencies": {
    "geomagnetism": "0.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
